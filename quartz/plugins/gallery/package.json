{
  "name": "@quartz-community/gallery",
  "version": "0.1.0",
  "description": "Markdown-driven masonry photo gallery for Quartz v5",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quartz-community/types": "^0.2.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.0",
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vfile": "^6.0.3"
  },
  "quartz": {
    "manifest": {
      "name": "gallery",
      "displayName": "Gallery 相册",
      "description": "让 md 文件变成瀑布流相册：frontmatter 加 gallery: true，正文图片自动渲染",
      "version": "0.1.0",
      "category": "transformer",
      "defaultEnabled": true,
      "defaultOrder": 55
    }
  }
}
